# Импортируем необходимые модули Python
import pandas as pd
from google.cloud import bigquery

# Создаем клиента BigQuery
client = bigquery.Client(project='urban-access-bot')

sql_query = """
-- Произведём агрегацию данных по гексагональной сетке:
-- для каждого гекса определим общее и среднее число POI в разбивке по категориям и заданным радиусам доступности 400/800/1200 метров (~5/10/15 минут пешей доступности).

CREATE TABLE `urban-access-bot.bot_dataset.pois_metrics_by_src_h3` AS (
WITH
  joined_data AS (
    SELECT *
    FROM `urban-access-bot.bot_geo.hex_neighbors_kl` t1
    INNER JOIN `urban-access-bot.bot_dataset.count_pois_h3` t2 ON t1.hex = t2.H3_id
  )
SELECT
    src_index,
    distance,
    SUM(RESTS_count) AS sum_rests,
    AVG(RESTS_count) AS avg_rests,
    SUM(CLINICS_count) AS sum_clinics,
    AVG(CLINICS_count) AS avg_clinics,
    SUM(HOSPITALS_count) AS sum_hospitals,
    AVG(HOSPITALS_count) AS avg_hospitals,
    SUM(KINDERGARTEN_count) AS sum_kindergarten,
    AVG(KINDERGARTEN_count) AS avg_kindergarten,
    SUM(MALLS_count) AS sum_malls,
    AVG(MALLS_count) AS avg_malls,
    SUM(OUTPOST_count) AS sum_outpost,
    AVG(OUTPOST_count) AS avg_outpost,    
    SUM(PHARMACIES_count) AS sum_pharmacies,
    AVG(PHARMACIES_count) AS avg_pharmacies,
    SUM(PARKS_count) AS sum_parks,
    AVG(PARKS_count) AS avg_parks,
    SUM(POLICE_count) AS sum_police,
    AVG(POLICE_count) AS avg_police,
    SUM(POST_count) AS sum_post,
    AVG(POST_count) AS avg_post,
    SUM(SCHOOLS_count) AS sum_schools,
    AVG(SCHOOLS_count) AS avg_schools,
    SUM(SHOPS_count) AS sum_shops,
    AVG(SHOPS_count) AS avg_shops,
    SUM(SPORT_count) AS sum_sport,
    AVG(SPORT_count) AS avg_sport,
    SUM(BUILDINGS_count) AS sum_buildings,
    AVG(BUILDINGS_count) AS avg_buildings
FROM joined_data
GROUP BY 
      src_index,
      distance
ORDER BY src_index, distance
);
"""

df = client.query(sql_query).to_dataframe() # Получаем результат в DataFrame Pandas
display(df)
